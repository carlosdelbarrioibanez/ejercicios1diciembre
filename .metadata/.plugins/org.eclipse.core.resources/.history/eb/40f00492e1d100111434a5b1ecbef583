package ejercicio4git; // Define el paquete al que pertenece esta clase

import java.util.Scanner; // Importa la clase Scanner para leer la entrada desde la consola

public class Ejercicio4Git { // Declara la clase principal Ejercicio4Git

	public static void main(String[] args) { // Método principal donde inicia el programa
		
		// Crear un objeto Scanner para capturar la entrada del usuario
		Scanner scanner = new Scanner(System.in);

		// Solicitar el primer carácter al usuario
		System.out.print("Ingresa el primer carácter: ");
		// Lee la palabra ingresada y obtiene el primer carácter (posición 0)
		char caracter1 = scanner.next().charAt(0);

		// Solicitar el segundo carácter al usuario
		System.out.print("Ingresa el segundo carácter: ");
		// Lee la siguiente palabra ingresada y obtiene el primer carácter (posición 0)
		char caracter2 = scanner.next().charAt(0);

		// Comparar si ambos caracteres son iguales con el operador ==
		if (caracter1 == caracter2) {
			// Se ejecuta si ambos caracteres tienen el mismo valor
			System.out.println("Los caracteres '" + caracter1 + "' y '" + caracter2 + "' son IGUALES.");
		} else {
			// Se ejecuta si los caracteres son diferentes
			System.out.println("Los caracteres '" + caracter1 + "' y '" + caracter2 + "' son DIFERENTES.");
		}

		// Cerrar el objeto Scanner para liberar los recursos asignados
		scanner.close();
	}

}